---
import '../styles/global.css';
import site from '../site';
const { lang } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description[lang]} />
    <meta name="keywords" content={site.keywords[lang]} />
    <title>{site.title[lang]}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="https://stvladnj.org/" />
    <link rel="alternate" hreflang="ru" href="https://stvladnj.org/ru/" />
  </head>
  <body>
    <slot />
  </body>
</html>
