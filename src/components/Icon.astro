---
// Inline SVG icons from src/icons/*.svg (Lucide + Simple Icons). Zero runtime.
const icons = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, ...rest } = Astro.props;
const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Unknown icon "${name}". Available: ${Object.keys(icons).join(', ')}`);
---
<span class="icon" aria-hidden="true" {...rest} set:html={svg}></span>
