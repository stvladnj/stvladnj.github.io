---
// The album index: one square cover per album, linking to its page. Covers crop —
// they are navigation. The photographs themselves are uncropped on the album page.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const { lang } = Astro.props;
const base = lang === 'en' ? '/' : '/ru/';
const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
---
<div class="albums">
  {albums.map(({ id, data }) => (
    <a class="album-cover" href={`${base}albums/${id}/`}>
      <Image src={data.cover ?? data.photos[0].src} alt=""
             widths={[200, 400]} sizes="200px" quality={72} layout="none" loading="lazy" decoding="async" />
      <span>{data.title[lang]} <small>({data.photos.length})</small></span>
    </a>
  ))}
</div>
